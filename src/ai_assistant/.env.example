# ─── Django Core ───────────────────────────────────────────────────────────────
# Generate a real key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-very-secret-key-here

DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ─── Database ──────────────────────────────────────────────────────────────────
# Leave blank to use SQLite (default for development)
# PostgreSQL example: postgres://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL=

# ─── AI Provider ───────────────────────────────────────────────────────────────
# Options: "openai" or "ollama"
AI_PROVIDER=ollama

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=sk-...your-key...
OPENAI_MODEL=gpt-4o-mini

# Ollama (used when AI_PROVIDER=ollama)
# Local development:  http://localhost:11434
# Docker Compose:     http://ollama:11434  (set automatically by docker-compose.yml)
OLLAMA_HOST=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2

# ─── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/
# Set Authorized JavaScript Origins to: http://localhost:8000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Media Files ───────────────────────────────────────────────────────────────
# Relative to manage.py — leave as default unless you need a custom path
MEDIA_ROOT=media/
